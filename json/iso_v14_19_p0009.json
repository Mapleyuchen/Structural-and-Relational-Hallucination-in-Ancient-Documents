        "attributes": {
          "group_id": "G_main41379",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main33",
        "polygon": [
          739,
          544,
          775,
          544,
          775,
          688,
          739,
          688
        ],
        "text": "不自借者",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41380",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main34",
        "polygon": [
          739,
          688,
          775,
          688,
          775,
          868,
          739,
          868
        ],
        "text": "如前日宋江",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41380",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main35",
        "polygon": [
          639,
          220,
          675,
          220,
          675,
          400,
          639,
          400
        ],
        "text": "之欲据斯座",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41380",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main36",
        "polygon": [
          639,
          400,
          675,
          400,
          675,
          688,
          639,
          688
        ],
        "text": "为李逵所不许是也",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41380",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main37",
        "polygon": [
          639,
          688,
          675,
          688,
          675,
          832,
          639,
          832
        ],
        "text": "不惜人者",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41380",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main38",
        "polygon": [
          639,
          832,
          675,
          832,
          675,
          868,
          639,
          868
        ],
        "text": "如",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41380",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main39",
        "polygon": [
          599,
          220,
          635,
          220,
          635,
          544,
          599,
          544
        ],
        "text": "今日宋江之欲逊斯座",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41380",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main40",
        "polygon": [
          599,
          544,
          635,
          544,
          635,
          868,
          599,
          868
        ],
        "text": "为卢员外所不许是也",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41380",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main41",
        "polygon": [
          559,
          220,
          595,
          220,
          595,
          292,
          559,
          292
        ],
        "text": "何也",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41381",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main42",
        "polygon": [
          559,
          292,
          595,
          292,
          595,
          472,
          559,
          472
        ],
        "text": "盖无耻之人",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41382",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main43",
        "polygon": [
          559,
          472,
          595,
          472,
          595,
          652,
          559,
          652
        ],
        "text": "其机械变诈",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41382",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main44",
        "polygon": [
          559,
          652,
          595,
          652,
          595,
          868,
          559,
          868
        ],
        "text": "大要归于必得",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41382",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main45",
        "polygon": [
          519,
          220,
          555,
          220,
          555,
          400,
          519,
          400
        ],
        "text": "斯座而后已",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41382",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main46",
        "polygon": [
          519,
          400,
          555,
          400,
          555,
          868,
          519,
          868
        ],
        "text": "不惟其前日之据之为必欲得之",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41382",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main47",
        "polygon": [
          479,
          220,
          515,
          220,
          515,
          760,
          479,
          760
        ],
        "text": "惟今日之逊之亦正其巧于必欲得之",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41382",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main48",
        "polygon": [
          479,
          760,
          515,
          760,
          515,
          868,
          479,
          868
        ],
        "text": "夫其意",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41383",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main49",
        "polygon": [
          439,
          220,
          475,
          220,
          475,
          472,
          439,
          472
        ],
        "text": "而既已必欲得之",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41383",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main50",
        "polygon": [
          439,
          472,
          475,
          472,
          475,
          868,
          439,
          868
        ],
        "text": "则是堂堂卢员外乃反为其",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41383",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main51",
        "polygon": [
          399,
          220,
          435,
          220,
          435,
          328,
          399,
          328
        ],
        "text": "所影借",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41383",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main52",
        "polygon": [
          399,
          328,
          435,
          328,
          435,
          688,
          399,
          688
        ],
        "text": "以作自身飞腾之尺木也",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41383",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main53",
        "polygon": [
          399,
          688,
          435,
          688,
          435,
          868,
          399,
          868
        ],
        "text": "此时为卢员",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41384",
          "z_index": 1
        }
      },
      {
        "node_id": "n_main54",
        "polygon": [
          359,
          220,
          395,
          220,
          395,
          292,
          359,
          292
        ],
        "text": "外者",
        "type": "MAIN_TEXT",
        "attributes": {
          "group_id": "G_main41384",
          "z_index": 1
        }
      },
